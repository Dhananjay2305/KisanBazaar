# Copy to frontend/.env for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Required — Supabase (client-side auth + direct uploads)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Required on Vercel only — serverless /api/upload-image fallback (Settings → keep as Secret)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional — override upload API URL (default: same origin /api/upload-image)
# VITE_UPLOAD_API_URL=https://your-app.vercel.app/api/upload-image

# Optional — legacy Express backend for old /uploads/* images (local dev)
# VITE_API_BASE=http://127.0.0.1:5001
